# Copy this file to ".env" and paste your real values in.
# .env is gitignored and must never be committed.

# From dashboard.plaid.com -> Developers -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# "sandbox" for fake test banks, "production" for real ones.
PLAID_ENV=sandbox

# Where the SQLite file lives. Relative to the project folder.
DATABASE_PATH=finance.db
